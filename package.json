{
  "name": "fitness-track",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "import-exercises": "node scripts/importFreeExerciseDB.ts",
    "seed:legacy": "node scripts/seedLegacyData.ts",
